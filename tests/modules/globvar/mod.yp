module globvar {
    version: "0.1.0",
    prefix: "gv_"
}

struct Point {
    i32 x,
    i32 y,
}

// Used before its declaration: globals are registered in Pass 1, like functions.
none fn bump() {
    counter = counter + 1;
}

i32 counter = 5;
_ limit = 100;
Point origin = {3, 4};
i32[3] table = {1, 2, 3};
byte@ name = c"globvar";

i32 fn seed() {
    ret 40;
}

// Not C constants, so these run at startup, in declaration order.
i32 seeded = seed() + 2;
i32[2] pair = {seed(), counter};

// A local with a global's name must shadow it, not alias it.
i32 fn shadowed() {
    i32 counter = 1;
    ret counter;
}
