// Literal macro arguments reach every parameter type that can read them as marshalled.
yExpr fn take_i32(i32 x){ ret yapi->int(x); }
yExpr fn take_i64(i64 x){ ret yapi->int(x.(i32)); }
yExpr fn take_byte(byte x){ ret yapi->int(x.(i32)); }
yExpr fn take_f64(f64@ x){ ret yapi->int((x. * 10.0).(i32)); }
yExpr fn take_bool(bool x){ if (x) { ret yapi->int(1); } ret yapi->int(0); }
yExpr fn take_str(byte@ s){ ret yapi->int(s:[0].(i32)); }

i32 fn main(){
    _ a = take_i32:(5);
    _ b = take_i64:(7);
    _ c = take_byte:(255);
    _ d = take_f64:(1.5);
    _ e = take_bool:(true);
    _ f = take_str:(c"A");
    _ g = take_str:("B");
    if (a != 5 || b != 7 || c != 255 || d != 15 || e != 1 || f != 65 || g != 66) ret 1;
    ret 0;
}
