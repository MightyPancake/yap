    deps: [
        "hashmap",
        "stdlib@0.1.0",
        "arr@^0.1.0",
        "io@latest",
        "vertest@local",
        { name: "math", version: "^0.1.0" },
        { name: "time", version: "0.1.0" },
    ],
}

i32 fn main(){
    ret 0;
}
