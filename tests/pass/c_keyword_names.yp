// yap names that are C keywords (or C header names) must still compile.
struct Box {
    i32 int,
    i32 default,
}

enum Mode {
    auto,
    register,
}

i32 fn double(i32 x) {
    ret x * 2;
}

yExpr fn float(yExpr x) {
    ret x;
}

i32 size_t = 3;

i32 fn main() {
    i32 char = 1;
    _ case = (i32 fn i32 x) { ret x + 1; };
    Box b = {.int = 2, .default = 4};
    Box@ p = b@;
    Mode m = Mode.register;
    if (double(char) != 2) ret 1;
    if (case(b.int) != 3) ret 2;
    if (p.default != 4 || p?.int != 2) ret 3;
    if (m.(i32) != 1) ret 4;
    if (float:(#size_t) != 3) ret 5;
    ret 0;
}
