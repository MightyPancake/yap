import globvar
import io

i32 g = 7;

i32 fn main(){
    if (g != 7) ret 1;
    g = g + 1;
    if (g != 8) ret 2;

    if (globvar->counter != 5) ret 3;
    globvar->bump();
    globvar->counter = globvar->counter + 10;
    if (globvar->counter != 16) ret 4;
    if (globvar->shadowed() != 1) ret 5;

    if (globvar->limit != 100) ret 6;
    if (globvar->origin.x + globvar->origin.y != 7) ret 7;
    if (globvar->table[2] != 3) ret 8;
    if (globvar->name[0] != 'g') ret 9;
    if (globvar->seeded != 42) ret 10;
    if (globvar->pair[0] != 40 || globvar->pair[1] != 5) ret 11;

    i32@ p = globvar->counter@;
    p. = 0;
    if (globvar->counter != 0) ret 12;

    if (io->fputs(c"to stdout\n", io->stdout) < 0) ret 13;
    if (io->fputs(c"to stderr\n", io->stderr) < 0) ret 14;
    if (io->fflush(io->stdout) != 0) ret 15;
    if (io->fileno(io->stdin) != 0) ret 16;
    if (io->fileno(io->stderr) != 2) ret 17;
    ret 0;
}
