import io
import globvar
import othervar

// Defined here, so it wins over globvar's seed().
i32 fn seed() {
    ret 1;
}

i32 fn main(){
    println:({c"bare println: ", 42});
    printf:(c"%d\n", {only_here()});
    if (only_here() != 3) ret 1;
    if (seed() != 1) ret 2;
    if (globvar->seed() != 40) ret 3;
    if (limit != 100) ret 4;
    limit = 5;
    if (globvar->limit != 5) ret 5;
    fputs(c"bare stdout\n", stdout);
    ret 0;
}
