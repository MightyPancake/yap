module containers {
    version: "0.1.0",
    prefix: "cont_",
    deps: ["arr@^0.1.0", "hashmap@^0.1.0"]
}

// Re-exports a chosen subset of this module's own dependencies:
//
//     import containers:(["arr"])            // just arr
//     import containers:(["arr", "hashmap"]) // both
//     import containers:()                   // everything it offers
//
// Names are checked against deps above, so asking for something containers does
// not carry is a compile error rather than a silent miss.
yDeclList fn __import(yExprList@ names) {
    _ l = yapi->decl_list_new();
    _ n = names..len.(i32);

    if (n == 0) {
        l = yapi->decl_list_push(l, yapi->import_module(c"arr"));
        l = yapi->decl_list_push(l, yapi->import_module(c"hashmap"));
        ret l;
    }

    i32 i = 0;
    while (i < n) {
        _ name = yapi->string_value(names.:[i]);
        l = yapi->decl_list_push(l, yapi->import_module(name));
        i = i + 1;
    }
    ret l;
}
